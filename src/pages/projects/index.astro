---
import { Image } from 'astro:assets'

import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'programs', text: 'Programs' }
]
---

<PageLayout title='Projects' {headings} view>
  <p>Github Activities:</p>
  <p>
    <Image
      src='https://ghchart.rshah.org/akatsuki033896'
      format='svg'
      alt='github activities'
      inferSize
      loading='lazy'
    />
  </p>

  <h2 id='programs'>Programs</h2>
  <ProjectSection
    projects={[
      {
        name: 'dotfiles',
        description: 'Dotfiles for my personal use, including neovim, terminals, etc.',
        links: [
          { type: 'github', href: 'https://github.com/akatsuki033896/dotfiles' }
        ]
      },
      {
        name: 'QGIS CMake Project Template',
        description:
          'A CMake project template for C++ QGIS secondary development.',
        links: [
          { type: 'github', href: 'https://github.com/akatsuki033896/QGIS-CMake-Template' }
        ]
      }
    ]}
  />
</PageLayout>